{
  "name": "nsdc-website",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "start": "vite build && wrangler pages dev dist --port 8788 --d1=DB --compatibility-date=2024-09-23",
    "dev": "vite build && concurrently -k -n api,ui \"npm:dev:api\" \"npm:dev:ui\"",
    "dev:api": "wrangler pages dev dist --port 8788 --d1=DB --compatibility-date=2024-09-23",
    "dev:ui": "vite",
    "build": "vite build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "vite": "^5.4.8",
    "wrangler": "^3.80.0"
  }
}
